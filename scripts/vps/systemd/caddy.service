[Unit]
Description=Caddy (alpha.turbopanel.net)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/home/alpha/.local/bin/caddy run --config /home/alpha/Caddyfile --adapter caddyfile
ExecReload=/home/alpha/.local/bin/caddy reload --config /home/alpha/Caddyfile --adapter caddyfile
TimeoutStopSec=5s
LimitNOFILE=1048576
Environment=XDG_DATA_HOME=/home/alpha/.local/share
Environment=XDG_CONFIG_HOME=/home/alpha/.config
# Must not set NoNewPrivileges=yes (would drop cap_net_bind_service).
# Must not set ProtectHome=yes (imports /home/website upstream snippets).

[Install]
WantedBy=default.target
