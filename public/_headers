# https://developers.cloudflare.com/workers/static-assets/headers
# Cloudflare serves these without invoking the worker, so the security header
# set from next.config.js `headers()` is repeated here — keep the two in step.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable
/screenshots/*
  Cache-Control: public,max-age=86400
/brand/social/*
  Cache-Control: public,max-age=31536000,immutable
