{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  "preview_urls": false,
  "keep_names": false,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-02-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "images": { "binding": "IMAGES" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "development-website" }],
  "observability": { "logs": { "enabled": true, "invocation_logs": true } },
  "vars": {
    "API_HOSTNAMES": "localhost:18787,Local Dev"
  },
  "name": "development-website",
  "workers_dev": false,
  "env": {
    "testing": {
      "name": "testing-website",
      "workers_dev": false,
      "images": { "binding": "IMAGES" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "testing-website" }],
      "route": { "pattern": "testing.turbopanel.io", "custom_domain": true },
      "vars": { "API_HOSTNAMES": "testing.turbopanel.dev,Testing API" }
    },
    "staging": {
      "name": "staging-website",
      "workers_dev": false,
      "images": { "binding": "IMAGES" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "staging-website" }],
      "route": { "pattern": "staging.turbopanel.io", "custom_domain": true },
      "vars": { "API_HOSTNAMES": "staging.turbopanel.dev,Staging API" }
    },
    "live": {
      "name": "website",
      "workers_dev": false,
      "images": { "binding": "IMAGES" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "website" }],
      "route": {
        "pattern": "turbopanel.io",
        "custom_domain": true
      },
      "vars": { "API_HOSTNAMES": "turbopanel.app,Production API" }
    }
  }
}
