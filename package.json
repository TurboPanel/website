{
  "name": "@turbopanel/website",
  "version": "0.1.14",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "dev": "next dev --port 19820",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "fumadocs-mdx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:ci": "pnpm lint && pnpm check:vocabulary && pnpm notices:check && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm check:docs-ssr",
    "check:docs-ssr": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docs-ssr.mjs",
    "check:vocabulary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-vocabulary.mjs",
    "notices:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-notices.mjs",
    "fmt:check:changed": "sh scripts/check-format-changed.sh",
    "notices:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-notices.mjs --check"
  },
  "dependencies": {
    "@scalar/api-reference-react": "^0.9.37",
    "@scalar/nextjs-api-reference": "^0.9.18",
    "@types/mdx": "^2.0.13",
    "fumadocs-core": "^16.5.4",
    "fumadocs-mdx": "^14.2.7",
    "fumadocs-ui": "^16.5.4",
    "mermaid": "^11.17.2",
    "next": "16.4.1",
    "next-themes": "^0.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@scalar/types": "0.13.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prettier": "3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "zod": "^4.6.6"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
