{
  "name": "@turbopanel/website",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 19820",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "fumadocs-mdx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:hosts": "node scripts/check-control-plane-hosts.mjs",
    "check:docs-ssr": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docs-ssr.mjs",
    "check:vocabulary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-vocabulary.mjs",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@scalar/api-reference-react": "^0.9.37",
    "@scalar/nextjs-api-reference": "^0.9.18",
    "@types/mdx": "^2.0.13",
    "fumadocs-core": "^16.5.4",
    "fumadocs-mdx": "^14.2.7",
    "fumadocs-ui": "^16.5.4",
    "mermaid": "^11.16.0",
    "next": "16.2.9",
    "next-themes": "^0.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@scalar/types": "0.13.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "@vitest/coverage-v8": "~3.0.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "vitest": "~3.0.5",
    "wrangler": "^4.124.0",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
