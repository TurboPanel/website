{
  "name": "@turbopanel/website",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 19820",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "fumadocs-mdx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:hosts": "node scripts/check-control-plane-hosts.mjs",
    "check:docs-ssr": "node scripts/check-docs-ssr.mjs",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@scalar/api-reference-react": "^0.9.37",
    "@scalar/nextjs-api-reference": "^0.9.18",
    "@types/mdx": "^2.0.13",
    "fumadocs-core": "^16.5.4",
    "fumadocs-mdx": "^14.2.7",
    "fumadocs-ui": "^16.5.4",
    "mermaid": "^11.16.0",
    "next": "16.2.9",
    "next-themes": "^0.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@scalar/types": "0.13.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "@vitest/coverage-v8": "~3.0.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "vitest": "~3.0.5",
    "wrangler": "^4.124.0",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
